# vervedocs-for-node 服务配置

# 服务端口
PORT=1320

# Java 可执行文件路径（默认使用 PATH 中的 java）
JAVA_BIN=java

# vervedocs-for-java jar 包路径（默认指向项目内 jars 目录）
JAR_PATH=./jars/vervedocs-for-java.jar

# JVM 堆内存配置
JAVA_OPTS=-Xmx512m

# 临时文件目录（默认使用系统临时目录）
TEMP_DIR=

# 临时文件自动清理（毫秒，默认 5 分钟）
TEMP_TTL=300000

# 日志级别：trace/debug/info/warn/error/fatal/silent（默认 info）
LOG_LEVEL=info

# 日志美化输出（带颜色、单行，类似 Java log4j2 风格）
# 设为 false 则输出原始 JSON（默认 true）
LOG_PRETTY=true

# 日志文件路径（设置后同时输出到 stdout 和该文件，文件始终为 JSON 格式）
# LOG_FILE=./logs/vervedocs-for-node.log