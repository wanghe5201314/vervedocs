{
  "name": "@vervedoc/for-node",
  "version": "0.1.0",
  "description": "VerveDocs Node 服务 - 桥接 vervedocs-for-java jar 包，提供 docx<->JSON/PDF HTTP API",
  "private": true,
  "type": "module",
  "scripts": {
    "vervedocs-for-node:dev": "tsx watch src/index.ts",
    "build": "tsc && node build.mjs",
    "start": "node dist/index.js",
    "type:check": "tsc --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "catalog:",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
