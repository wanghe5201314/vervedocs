{
  "name": "@wanghe1995/docx-editor-core",
  "version": "3.0.10",
  "description": "DocxEditor 核心编辑器库",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-editor-core.umd.cjs",
  "module": "./dist/docx-editor-core.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docx-editor-core.js",
      "require": "./dist/docx-editor-core.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^3.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@wanghe1995/docx-editor-commands": "^1.0.3",
    "@wanghe1995/docx-editor-comment": "^1.0.6",
    "@wanghe1995/docx-editor-history": "^1.0.7",
    "@wanghe1995/docx-editor-keymap": "^1.0.4",
    "@wanghe1995/docx-editor-schema": "^1.0.6",
    "@wanghe1995/docx-editor-state": "^1.0.2",
    "@wanghe1995/docx-editor-transform": "^1.0.7",
    "@wanghe1995/docx-editor-view": "1.0.4",
    "docx": "^9.1.0",
    "jszip": "^3.10.1",
    "vanilla-picker": "^2.12.3"
  }
}
