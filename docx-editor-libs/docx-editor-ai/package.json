{
  "name": "@wanghe1995/docx-editor-ai",
  "version": "1.0.1",
  "description": "DocxEditor AI 智能编辑插件 - 选中内容智能修改、润色、翻译等",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-editor-ai.umd.cjs",
  "module": "./dist/docx-editor-ai.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docx-editor-ai.js",
      "require": "./dist/docx-editor-ai.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "docx-editor-ai",
    "editor",
    "docx-editor"
  ],
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@wanghe1995/docx-editor-core": "file:../../docx-editor-core"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.10",
    "vite-plugin-css-injected-by-js": "^3.0.0",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
