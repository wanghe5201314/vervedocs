{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@wanghe1995/docx-editor-view": ["../docx-editor-view/dist/index.d.ts"],
      "@wanghe1995/docx-editor-schema": ["../docx-editor-schema/dist/index.d.ts"],
      "@wanghe1995/docx-editor-state": ["../docx-editor-state/dist/index.d.ts"],
      "@wanghe1995/docx-editor-transform": ["../docx-editor-transform/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
