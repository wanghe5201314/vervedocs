{
  "name": "@vervedoc/core",
  "version": "3.0.11",
  "description": "VerveDoc Core 核心编辑器库（Canvas 2D 高性能实现）",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/core.umd.cjs",
    "module": "./dist/core.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/core.js",
        "require": "./dist/core.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "pnpm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^3.0.0",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@vervedoc/docx-editor-schema": "workspace:^",
    "@vervedoc/docx-editor-state": "workspace:^",
    "@vervedoc/docx-editor-transform": "workspace:^",
    "@vervedoc/docx-editor-view": "workspace:^",
    "@vervedoc/docx-editor-comment": "workspace:^",
    "@vervedoc/docx-editor-commands": "workspace:^",
    "@vervedoc/docx-editor-history": "workspace:^"
  }
}
