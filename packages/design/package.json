{
  "name": "@vervedoc/design",
  "version": "1.0.0",
  "description": "VerveDoc design tokens, icon font assets, and icon name map",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./styles.css": "./src/styles/index.css",
    "./tokens.css": "./src/styles/tokens.css",
    "./icons.css": "./src/fonts/material-symbols.css"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/vervedoc-design.js",
    "module": "./dist/vervedoc-design.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/vervedoc-design.js"
      },
      "./styles.css": "./dist/styles.css",
      "./tokens.css": "./src/styles/tokens.css",
      "./icons.css": "./src/fonts/material-symbols.css"
    }
  },
  "keywords": [
    "vervedoc-design",
    "design-tokens",
    "css-variables"
  ],
  "files": [
    "dist",
    "src",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "lib": "pnpm run clean && vite build",
    "build": "pnpm run lib",
    "type:check": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
