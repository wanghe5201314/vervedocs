{
  "name": "@vervedoc/docx-lite",
  "version": "1.1.10",
  "description": "玉衡云文档 轻量版UI",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-lite.umd.cjs",
  "module": "./dist/docx-lite.js",
  "browser": "./dist/docx-lite.browser.js",
  "types": "./dist/editor/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/docx-lite.js",
      "require": "./dist/docx-lite.umd.cjs"
    },
    "./browser": "./dist/docx-lite.browser.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "pnpm run clean && vite build && vite build --config vite.browser.config.ts",
    "lint": "eslint .",
    "type:check": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^2.4.0",
    "vite-plugin-dts": "catalog:",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@vervedoc/core": "workspace:^",
    "@vervedoc/design": "workspace:^",
    "@vervedoc/ui": "workspace:^",
    "vue": "catalog:"
  },
  "peerDependencies": {
    "vue": "catalog:"
  }
}
