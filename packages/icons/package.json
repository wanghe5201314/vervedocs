{
  "name": "@vervedoc/icons",
  "version": "1.0.0",
  "description": "VerveDoc 统一图标库 - 基于 Material Icons 字体",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/vervedoc-icons.js",
    "module": "./dist/vervedoc-icons.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/vervedoc-icons.js"
      }
    }
  },
  "keywords": [
    "vervedoc-icons",
    "material-icons",
    "icon",
    "vue"
  ],
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "lib": "pnpm run clean && vite build",
    "build": "pnpm run lib",
    "type:check": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^2.4.0",
    "vite-plugin-dts": "catalog:",
    "vue": "^3.5.12",
    "vue-tsc": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
