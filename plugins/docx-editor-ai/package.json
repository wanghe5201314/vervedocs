{
  "name": "@vervedoc/docx-editor-ai",
  "version": "1.0.3",
  "description": "DocxEditor AI 智能编辑插件 - 选中内容智能修改、润色、翻译等",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/docx-editor-ai.umd.cjs",
    "module": "./dist/docx-editor-ai.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/docx-editor-ai.js",
        "require": "./dist/docx-editor-ai.umd.cjs"
      }
    }
  },
  "keywords": [
    "docx-editor-ai",
    "editor",
    "docx-editor"
  ],
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "pnpm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-css-injected-by-js": "^3.0.0",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
