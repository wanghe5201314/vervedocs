{
  "name": "@vervedoc/docx-editor-chart",
  "version": "1.0.4",
  "description": "DocxEditor 图表插件 - 基于 ECharts",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "keywords": [
    "docx-editor-chart",
    "editor",
    "docx-editor"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/docx-editor-chart.umd.cjs",
    "module": "./dist/docx-editor-chart.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/docx-editor-chart.js",
        "require": "./dist/docx-editor-chart.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "echarts": "^5.0.0 || ^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@vervedoc/docx-editor-schema": "workspace:^",
    "echarts": "^5.6.0",
    "esbuild": "^0.25.5",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  }
}
