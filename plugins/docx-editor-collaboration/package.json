{
  "name": "@vervedoc/docx-editor-collaboration",
  "version": "1.0.4",
  "description": "DocxEditor 协同编辑库 - 基于 Yjs CRDT + Hocuspocus 实现实时协作",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/docx-editor-collaboration.umd.cjs",
    "module": "./dist/docx-editor-collaboration.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/docx-editor-collaboration.js",
        "require": "./dist/docx-editor-collaboration.umd.cjs"
      }
    }
  },
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "pnpm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@hocuspocus/provider": "^2.15.0",
    "eventemitter3": "^5.0.1",
    "fast-json-patch": "^3.1.1",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.20"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.25.5",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
