{
  "name": "@vervedoc/docx-editor-schema",
  "version": "1.0.10",
  "description": "DocxEditor 文档Schema层 - Schema、类型定义、常量、工具函数",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/docx-editor-schema.umd.cjs",
    "module": "./dist/docx-editor-schema.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/docx-editor-schema.js",
        "require": "./dist/docx-editor-schema.umd.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "pnpm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "fast-deep-equal": "^3.1.3",
    "just-debounce-it": "^3.2.0",
    "just-merge": "^3.2.0",
    "just-omit": "^2.2.0",
    "just-pick": "^4.2.0",
    "just-throttle": "^4.2.0",
    "nanoid": "^5.1.11",
    "rfdc": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "esbuild": "^0.25.5",
    "eslint": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
