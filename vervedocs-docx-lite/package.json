{
  "name": "@vervedoc/docx-lite",
  "version": "1.0.8",
  "description": "玉衡云文档 轻量版UI",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-lite.umd.cjs",
  "module": "./dist/docx-lite.js",
  "browser": "./dist/docx-lite.browser.js",
  "types": "./dist/editor/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/editor/index.d.ts",
      "import": "./dist/docx-lite.js",
      "require": "./dist/docx-lite.umd.cjs"
    },
    "./browser": "./dist/docx-lite.browser.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "static",
    "fonts",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "npm run clean && vite build --config vite.lib.config.ts && vite build --config vite.browser.config.ts",
    "lint": "eslint .",
    "type:check": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^11.1.6",
    "@types/node": "^25.3.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "tslib": "^2.8.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vite-plugin-css-injected-by-js": "^2.4.0",
    "vite-plugin-dts": "^4.5.4",
    "vue-tsc": "^2.0.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "dependencies": {
    "@vervedoc/core": "^3.0.11",
    "vue": "^3.4.0"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  }
}
