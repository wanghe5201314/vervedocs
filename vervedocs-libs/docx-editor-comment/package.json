{
  "name": "@vervedoc/docx-editor-comment",
  "version": "1.0.6",
  "description": "DocxEditor 批注系统模块",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-editor-comment.umd.cjs",
  "module": "./dist/docx-editor-comment.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docx-editor-comment.js",
      "require": "./dist/docx-editor-comment.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@vervedoc/docx-editor-schema": "file:../docx-editor-schema",
    "@vervedoc/docx-editor-state": "file:../docx-editor-state",
    "@vervedoc/docx-editor-transform": "file:../docx-editor-transform"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
