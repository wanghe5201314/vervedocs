{
  "name": "@vervedoc/docx-editor-history",
  "version": "1.0.7",
  "description": "DocxEditor 历史管理插件 - 撤销/重做",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-editor-history.umd.cjs",
  "module": "./dist/docx-editor-history.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docx-editor-history.js",
      "require": "./dist/docx-editor-history.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "docx-editor-history",
    "editor",
    "docx-editor"
  ],
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "@vervedoc/docx-editor-schema": "1.0.7",
    "@vervedoc/docx-editor-state": "1.0.2",
    "@vervedoc/docx-editor-transform": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.25.5",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
