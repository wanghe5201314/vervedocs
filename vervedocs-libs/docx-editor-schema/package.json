{
  "name": "@vervedoc/docx-editor-schema",
  "version": "1.0.9",
  "description": "DocxEditor 文档Schema层 - Schema、类型定义、常量、工具函数",
  "author": "wanghe",
  "license": "MIT",
  "type": "module",
  "main": "./dist/docx-editor-schema.umd.cjs",
  "module": "./dist/docx-editor-schema.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/docx-editor-schema.js",
      "require": "./dist/docx-editor-schema.umd.cjs"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "node -e \"const fs = require('fs'); if(fs.existsSync('dist')) fs.rmSync('dist', {recursive: true})\"",
    "build": "npm run clean && tsc && vite build",
    "preview": "vite preview",
    "type:check": "tsc --noEmit"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "fast-deep-equal": "^3.1.3",
    "just-debounce-it": "^3.2.0",
    "just-merge": "^3.2.0",
    "just-omit": "^2.2.0",
    "just-pick": "^4.2.0",
    "just-throttle": "^4.2.0",
    "nanoid": "^5.1.11",
    "rfdc": "^1.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.3.3",
    "esbuild": "^0.25.5",
    "eslint": "^10.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
